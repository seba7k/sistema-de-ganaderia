<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Necesario para depurar con el comando flutter (hot reload, breakpoints). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Solo en desarrollo: permite probar contra el servidor local sin HTTPS
         (por ejemplo http://10.0.2.2:8000 desde el emulador). La versión de
         producción exige HTTPS. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
